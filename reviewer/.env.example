# Copy the keys you need into .env (which is gitignored). Never commit real values.

# Which PR to review. In GitHub Actions these come from the workflow instead.
GITHUB_REPOSITORY=aadityanaik007/PR-tester
PR_NUMBER=1

# GitHub: fine-grained token with "Pull requests: Read and write" on the repo.
# Optional for reading a public repo, required for posting the review.
GITHUB_TOKEN=

# Anthropic (reviewer + verifier nodes)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pr-reviewer

# true = print the review instead of posting it to GitHub
DRY_RUN=true
